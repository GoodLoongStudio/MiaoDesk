# 默认：文本自动规范化（仓库内统一 LF）
* text=auto

# Windows 脚本保持 CRLF，避免老版 cmd.exe 解析问题
*.cmd text eol=crlf
*.bat text eol=crlf

# Wallpaper/widget media assets use Git LFS so .mdwall/.mdwidget packs can grow
# without bloating Git history.
assets/wallpapers/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/wallpapers/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/wallpapers/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/wallpapers/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/wallpapers/**/*.gif filter=lfs diff=lfs merge=lfs -text
assets/wallpapers/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
assets/wallpapers/**/*.webm filter=lfs diff=lfs merge=lfs -text
assets/widgets/**/*.png filter=lfs diff=lfs merge=lfs -text
assets/widgets/**/*.jpg filter=lfs diff=lfs merge=lfs -text
assets/widgets/**/*.jpeg filter=lfs diff=lfs merge=lfs -text
assets/widgets/**/*.webp filter=lfs diff=lfs merge=lfs -text
assets/widgets/**/*.gif filter=lfs diff=lfs merge=lfs -text
assets/widgets/**/*.mp4 filter=lfs diff=lfs merge=lfs -text
assets/widgets/**/*.webm filter=lfs diff=lfs merge=lfs -text

# 其他二进制保持普通 Git 二进制，防止行尾转换或无意义 diff
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.exe binary
*.dll binary
*.lib binary
*.pdb binary
*.node binary
*.woff binary
*.woff2 binary
*.zip binary
*.unityweb binary

# 生成物不参与 diff
*.lock linguist-generated=true